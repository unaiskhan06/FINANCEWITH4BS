ADMIN_PASSWORD=financewithmujeeb

# ─── Database ───
# Option A — hosted database (used in production). Takes priority when set.
#   postgresql://user:password@host:5432/dbname
#   mysql://user:password@host:3306/dbname
DATABASE_URL=postgresql://finance_rates:Lbva7gpieZ8eNVS0hpnYpIj98er3qFum@dpg-daps2nmgekts73f0lk7g-a.virginia-postgres.render.com/finance_rates

# Option B — local MySQL (used when DATABASE_URL is empty)
#MYSQL_HOST=localhost
#MYSQL_PORT=3306
#MYSQL_USER=root
#MYSQL_PASSWORD=
#MYSQL_DATABASE=finance_rates
