# ─── Flask ───
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=d9b0ff8e6c2f4a71b35ec4a0d7182f6c5be93a4471dd2e08c6f5a1b39e7c0d24
FLASK_DEBUG=0

# ─── Admin panel login (/admin) ───
# The admin panel stays locked until both are set.
